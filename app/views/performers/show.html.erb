<% if user_signed_in? && current_user.performer == @performer %>
  <% content_for :nav_extras do %>
    <%= link_to t("nav.manage_events"), performer_events_path(@performer), class: "btn btn-outline-secondary btn-sm" %>
  <% end %>
<% end %>

<% if user_signed_in? %>
  <div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6">
      <p class="text-muted mb-4"><%= t("performers.notifications_description", performer: @performer.name) %></p>

      <div class="card shadow-sm">
        <div class="card-header bg-white fw-semibold border-bottom"><%= t("performers.setup_notification") %></div>
        <div class="card-body">
          <%= form_with model: @notification do |form| %>
            <div class="mb-3" data-controller="location-autocomplete"
                              data-action="click@window->location-autocomplete#clickOutside">
              <%= form.label :location, class: "form-label" %>
              <div class="position-relative">
                <%= form.search_field :location, class: "form-control", placeholder: t("performers.location_placeholder"),
                      autocomplete: "off",
                      data: {
                        location_autocomplete_target: "input",
                        action: "input->location-autocomplete#onInput"
                      } %>
                <div data-location-autocomplete-target="dropdown"
                     class="dropdown-menu w-100"
                     style="top:100%;max-height:220px;overflow-y:auto;"></div>
              </div>
            </div>
            <div class="mb-3">
              <%= form.label :distance, t("performers.max_distance"), class: "form-label" %>
              <%= form.number_field :distance, in: 0.0..1000.0, step: 5, class: "form-control" %>
            </div>
            <input type="hidden" id="performer_id" name="notification[performer_id]" value="<%= @performer.id %>">
            <%= form.submit t("performers.save_notification"), class: "btn btn-primary" %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
<% end %>
<div class="row justify-content-center mt-4">
  <div class="col-12 col-sm-9 col-md-7 col-lg-5 text-center">
    <%= link_to t("performers.performer_cta"), new_user_registration_path, class: "text-muted small" %>
  </div>
</div>
