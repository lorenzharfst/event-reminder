<% if !user_signed_in? %>
  <div class="row justify-content-center">
    <div class="col-12 col-sm-9 col-md-7 col-lg-5">
      <div class="card shadow-sm text-center">
        <div class="card-body p-5">
          <h2 class="card-title fw-bold mb-2"><%= t("performers.sign_in_to_subscribe") %></h2>
          <p class="text-muted mb-4"><%= t("performers.sign_in_description") %></p>
          <%= link_to t("performers.log_in"), new_user_session_path, class: "btn btn-primary me-2" %>
          <%= link_to t("performers.sign_up"), new_user_registration_path, class: "btn btn-outline-secondary" %>

          <hr class="my-4">

          <div class="d-grid">
            <%= button_to user_google_oauth2_omniauth_authorize_path, data: { turbo: false }, class: "btn btn-outline-danger w-100" do %>
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 48 48" class="me-2" style="vertical-align: text-bottom;">
                <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
                <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
                <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/>
                <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
                <path fill="none" d="M0 0h48v48H0z"/>
              </svg>
              <%= t("auth.links.sign_in_with", provider: "Google") %>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="row justify-content-center mt-4">
    <div class="col-12 col-sm-9 col-md-7 col-lg-5 text-center">
      <%= link_to t("performers.performer_cta"), new_user_registration_path, class: "text-muted small" %>
    </div>
  </div>

<% elsif user_signed_in? %>
  <div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6">
      <h1 class="fw-bold mb-1"><%= t("performers.notifications_title") %></h1>
      <p class="text-muted mb-4"><%= t("performers.notifications_description") %></p>

      <div class="card shadow-sm">
        <div class="card-header bg-white fw-semibold border-bottom"><%= t("performers.setup_notification") %></div>
        <div class="card-body">
          <%= form_with model: @notification do |form| %>
            <div class="mb-3">
              <%= form.label :location, class: "form-label" %>
              <%= form.search_field :location, class: "form-control", placeholder: t("performers.location_placeholder") %>
            </div>
            <div class="mb-3">
              <%= form.label :distance, t("performers.max_distance"), class: "form-label" %>
              <%= form.number_field :distance, in: 0.0..1000.0, step: 5, class: "form-control" %>
            </div>
            <input type="hidden" id="performer_id" name="notification[performer_id]" value="<%= @performer.id %>">
            <%= form.submit t("performers.save_notification"), class: "btn btn-primary" %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
<% end %>
