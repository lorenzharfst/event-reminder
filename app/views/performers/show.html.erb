<% if !user_signed_in? %>
  <div class="row justify-content-center">
    <div class="col-12 col-sm-9 col-md-7 col-lg-5">
      <div class="card shadow-sm">
        <div class="card-body p-4">
          <h2 class="card-title mb-1 fw-bold">Log in</h2>
          <p class="text-muted small mb-4">Sign in to manage your notifications.</p>

          <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
            <div class="mb-3">
              <%= f.label :email, class: "form-label" %>
              <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-control" %>
            </div>
            <div class="mb-3">
              <%= f.label :password, class: "form-label" %>
              <%= f.password_field :password, autocomplete: "current-password", class: "form-control" %>
            </div>
            <% if devise_mapping.rememberable? %>
              <div class="mb-3 form-check">
                <%= f.check_box :remember_me, class: "form-check-input" %>
                <%= f.label :remember_me, class: "form-check-label" %>
              </div>
            <% end %>
            <div class="d-grid mb-3">
              <%= f.submit "Log in", class: "btn btn-primary" %>
            </div>
          <% end %>

          <hr class="my-3">
          <%= render "devise/shared/links" %>
        </div>
      </div>
    </div>
  </div>

<% elsif user_signed_in? %>
  <div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6">
      <h1 class="fw-bold mb-1">Notifications</h1>
      <p class="text-muted mb-4">Subscribe to get notified when an event is near your location.</p>

      <div class="card shadow-sm">
        <div class="card-header bg-white fw-semibold border-bottom">Set up a notification</div>
        <div class="card-body">
          <%= form_with model: @notification do |form| %>
            <div class="mb-3">
              <%= form.label :location, class: "form-label" %>
              <%= form.search_field :location, class: "form-control", placeholder: "Your city or region" %>
            </div>
            <div class="mb-3">
              <%= form.label :distance, "Maximum distance (km)", class: "form-label" %>
              <%= form.number_field :distance, in: 0.0..1000.0, step: 5, class: "form-control" %>
            </div>
            <input type="hidden" id="performer_id" name="notification[performer_id]" value="<%= @performer.id %>">
            <%= form.submit "Save notification", class: "btn btn-primary" %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
<% end %>
