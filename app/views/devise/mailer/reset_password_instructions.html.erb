<p style="margin:0 0 8px;font-size:20px;font-weight:700;color:#212529;"><%= t("mailer.reset_password.heading") %></p>
<p style="margin:0 0 24px;font-size:15px;color:#6c757d;"><%= t("mailer.reset_password.subtitle", email: @resource.email) %></p>

<p style="margin:0 0 28px;text-align:center;">
  <%= link_to t("mailer.reset_password.button"), edit_password_url(@resource, reset_password_token: @token),
      style: "display:inline-block;background-color:#0d6efd;color:#ffffff;padding:12px 28px;border-radius:6px;text-decoration:none;font-size:15px;font-weight:600;" %>
</p>

<p style="margin:0;font-size:13px;color:#adb5bd;"><%= t("mailer.reset_password.ignore") %></p>
