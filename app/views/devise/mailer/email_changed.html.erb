<p style="margin:0 0 8px;font-size:20px;font-weight:700;color:#212529;"><%= t("mailer.email_changed.heading") %></p>
<% if @resource.try(:unconfirmed_email?) %>
  <p style="margin:0;font-size:15px;color:#6c757d;"><%= t("mailer.email_changed.being_changed", email: @resource.unconfirmed_email) %></p>
<% else %>
  <p style="margin:0;font-size:15px;color:#6c757d;"><%= t("mailer.email_changed.changed", email: @resource.email) %></p>
<% end %>
