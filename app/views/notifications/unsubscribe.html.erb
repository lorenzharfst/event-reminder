<div class="row justify-content-center">
  <div class="col-12 col-md-6 col-lg-5">
    <div class="card shadow-sm mt-5">
      <div class="card-body p-4">
        <h2 class="fw-bold mb-2"><%= t("notifications.unsubscribe_title") %></h2>
        <p class="text-muted mb-4"><%= t("notifications.unsubscribe_choose") %></p>

        <%= form_with url: confirm_unsubscribe_notification_path(params[:token]), method: :post do |f| %>
          <div class="d-grid gap-3">
            <%= f.submit t("notifications.unsubscribe_performer", performer: @notification.performer.name),
                  name: "scope", value: "performer",
                  class: "btn btn-outline-danger text-start" %>
            <%= f.submit t("notifications.unsubscribe_all_button"),
                  name: "scope", value: "all",
                  class: "btn btn-danger text-start" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
