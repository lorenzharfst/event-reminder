<!DOCTYPE html>
<html lang="en">
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Event Reminder</title>
  </head>
  <body style="margin:0;padding:0;background-color:#f8f9fa;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue',Arial,sans-serif;color:#212529;">
    <table width="100%" cellpadding="0" cellspacing="0" style="background-color:#f8f9fa;padding:32px 16px;">
      <tr>
        <td align="center">
          <table width="100%" cellpadding="0" cellspacing="0" style="max-width:560px;">
            <tr>
              <td style="background-color:#212529;padding:20px 28px;border-radius:8px 8px 0 0;">
                <span style="color:#ffffff;font-size:18px;font-weight:700;letter-spacing:-0.2px;">Event Reminder</span>
              </td>
            </tr>
            <tr>
              <td style="background-color:#ffffff;padding:36px 28px;border-radius:0 0 8px 8px;box-shadow:0 1px 4px rgba(0,0,0,0.08);">
                <%= yield %>
              </td>
            </tr>
            <tr>
              <td style="padding:20px 28px;text-align:center;color:#6c757d;font-size:12px;line-height:1.6;">
                You received this email because you subscribed to event notifications on Event Reminder.
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
