<div class="mb-4">
  <h1 class="fw-bold mb-0"><%= t("events.title", performer: @performer.name) %></h1>
  <hr class="mt-2">
</div>

<% if current_user.performer.id == @performer.id %>
  <div class="row g-4">
    <div class="col-12 col-lg-6">
      <div class="card shadow-sm h-100">
        <div class="card-header bg-white fw-semibold border-bottom"><%= t("events.update_stage_name") %></div>
        <div class="card-body">
          <%= form_with model: @performer do |form| %>
            <div class="mb-3">
              <%= form.label :name, class: "form-label" %>
              <%= form.text_field :name, class: "form-control" %>
            </div>
            <%= form.submit t("events.update"), class: "btn btn-outline-secondary" %>
          <% end %>
        </div>
      </div>
    </div>

    <div class="col-12 col-lg-6">
      <div class="card shadow-sm h-100">
        <div class="card-header bg-white fw-semibold border-bottom"><%= t("events.add_new_event") %></div>
        <div class="card-body">
          <%= form_with model: @event, url: "/performers/#{@performer.id}/events", method: "post" do |form| %>
            <div class="mb-3">
              <%= form.label :event_date, class: "form-label" %>
              <%= form.date_field :event_date, class: "form-control" %>
            </div>
            <div class="mb-3" data-controller="location-autocomplete"
                              data-action="click@window->location-autocomplete#clickOutside">
              <%= form.label :location, class: "form-label" %>
              <div class="position-relative">
                <%= form.search_field :location, class: "form-control", placeholder: t("events.location_placeholder"),
                      autocomplete: "off",
                      data: {
                        location_autocomplete_target: "input",
                        action: "input->location-autocomplete#onInput"
                      } %>
                <div data-location-autocomplete-target="dropdown"
                     class="dropdown-menu w-100"
                     style="top:100%;max-height:220px;overflow-y:auto;"></div>
              </div>
            </div>
            <div class="mb-3">
              <%= form.label :venue, class: "form-label" %>
              <%= form.text_field :venue, class: "form-control", placeholder: t("events.venue_placeholder") %>
            </div>
            <%= form.submit t("events.add_event"), class: "btn btn-primary" %>
          <% end %>
        </div>
      </div>
    </div>

    <div class="col-12">
      <div class="card shadow-sm">
        <div class="card-header bg-white fw-semibold border-bottom"><%= t("events.upcoming_events") %></div>
        <% if @event_list.any? %>
          <ul class="list-group list-group-flush">
            <% @event_list.each do |event| %>
              <li class="list-group-item d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2 py-3">
                <div>
                  <span class="fw-semibold"><%= event.location %></span>
                  <% if event.venue.present? %>
                    <span class="text-muted small ms-1">— <%= event.venue %></span>
                  <% end %>
                </div>
                <div class="d-flex align-items-center gap-2">
                  <span class="badge bg-primary rounded-pill"><%= event.event_date.strftime("%b %-d, %Y") %></span>
                  <%= button_to t("events.delete"), performer_event_path(@performer, event), method: :delete, data: { turbo_confirm: t("events.delete_confirm") }, class: "btn btn-outline-danger btn-sm" %>
                </div>
              </li>
            <% end %>
          </ul>
        <% else %>
          <div class="card-body text-muted fst-italic"><%= t("events.no_events") %></div>
        <% end %>
      </div>
    </div>
  </div>
<% end %>
